{{- if eq .chezmoi.os "windows" -}}
# Copy files listed in .chezmoidata/outside_home.yaml to their targets.
$ErrorActionPreference = "Stop"
{{ range .outside_home -}}
{{- $target := index .targets $.chezmoi.os -}}
{{- if $target }}
$source = '{{ joinPath $.chezmoi.sourceDir .source }}'
$target = "{{ $target | replace "{dev_dir}" $.dev_dir }}"
if (-not (Test-Path $target) -or (Get-FileHash $source).Hash -ne (Get-FileHash $target).Hash) {
    New-Item -ItemType Directory -Force -Path (Split-Path $target) | Out-Null
    Copy-Item -Force $source $target
    Write-Host "Deployed $target"
}
{{- end }}
{{- end }}
{{- end }}
