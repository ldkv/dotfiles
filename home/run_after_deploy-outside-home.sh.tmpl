{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
# Copy files listed in .chezmoidata/outside_home.yaml to their targets.
set -eu
{{ range .outside_home -}}
{{- $target := index .targets $.chezmoi.os -}}
{{- if $target }}
source={{ joinPath $.chezmoi.sourceDir .source | quote }}
target={{ $target | replace "{dev_dir}" $.dev_dir | quote }}
if ! cmp -s "$source" "$target"; then
    mkdir -p "$(dirname "$target")"
    cp "$source" "$target"
    echo "Deployed $target"
fi
{{- end }}
{{- end }}
{{- end }}
